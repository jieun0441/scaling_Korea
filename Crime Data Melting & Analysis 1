 및 매핑\n","df_pooled = df_city_major_final.copy()\n","df_pooled['Crime_Type_Major'] = df_pooled['Crime_Type_Major'].map(crime_eng_map_full).fillna(df_pooled['Crime_Type_Major'])\n","\n","# 3. 로그 변환 (Log-Log Plot을 위해 미리 계산)\n","# 0이 아닌 데이터만 남김\n","df_pooled = df_pooled[(df_pooled['Crime_Count'] > 0) & (df_pooled['Pop_Reg'] > 0)]\n","df_pooled['Log_Pop'] = np.log(df_pooled['Pop_Reg'])\n","df_pooled['Log_Crime'] = np.log(df_pooled['Crime_Count'])\n","\n","# ==============================================================================\n","# [Visualization] FacetGrid Scatter Plot with Regression Line\n","# ==============================================================================\n","\n","# 스타일 설정 (Arial, Whitegrid)\n","plt.rcParams['font.family'] = 'Arial'\n","sns.set_style(\"whitegrid\")\n","\n","# lmplot 생성 (Crime Type별로 서브플롯 생성)\n","# col_wrap: 한 줄에 몇 개 그릴지 설정 (4개 추천)\n","g = sns.lmplot(\n","    data=df_pooled,\n","    x=\"Log_Pop\",\n","    y=\"Log_Crime\",\n","    col=\"Crime_Type_Major\",\n","    col_wrap=4,              # 4열로 배치\n","    height=3,                # 개별 그래프 높이\n","    aspect=1,                # 개별 그래프 가로세로 비율\n","    scatter_kws={'alpha': 0.3, 's': 10, 'color': 'gray'}, # 점 스타일 (투명도, 크기, 색상)\n","    line_kws={'color': 'red', 'linewidth': 1.5},          # 회귀선 스타일\n","    sharex=False, sharey=False # 축 범위를 각각 다르게 설정 (데이터 분포가 다르므로)\n",")\n","\n","# ==============================================================================\n","# [Annotation] 각 그래프에 Beta(기울기)와 R-squared 표시\n","# ==============================================================================\n","\n","def annotate_stats(data, **kws):\n","    x = data['Log_Pop']\n","    y = data['Log_Crime']\n","\n","    # 선형 회귀분석 수행 (SciPy)\n","    slope, intercept, r_value, p_value, std_err = stats.linregress(x, y)\n","\n","    # 텍스트 표시 (왼쪽 상단)\n","    ax = plt.gca()\n","    text_content = f'β = {slope:.2f}\\n$R^2$ = {r_value**2:.2f}\\nN = {len(x)}'\n","\n","    # 좌표는 그래프 내부 상대 좌표 (0.05, 0.95 -> 왼쪽 위)\n","    ax.text(0.05, 0.75, text_content, transform=ax.transAxes,\n","            fontsize=9, fontweight='bold', color='black',\n","            bbox=dict(boxstyle=\"round,pad=0.3\", fc=\"white\", ec=\"black\", alpha=0.8))\n","\n","# 각 Facet에 통계 정보 매핑\n","g.map_dataframe(annotate_stats)\n","\n","# ==============================================================================\n","# [Final Polish] 축 이름 및 타이틀 정리\n","# ==============================================================================\n","g.set_axis_labels(\"ln(Population)\", \"ln(Crime Count)\")\n","g.fig.suptitle(\"Pooled Urban Scaling Analysis by Crime Type (2015-2024)\", fontsize=16, fontweight='bold', y=1.02)\n","\n","plt.tight_layout()\n","plt.savefig('/content/drive/MyDrive/Urban Scaling/Crime Data/Figures/Fig3_Pooled_Scaling_Scatter_Matrix.jpg', dpi=300, bbox_inches='tight')\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"qJI4SVimjKGm","executionInfo":{"status":"ok","timestamp":1772607474926,"user_tz":-540,"elapsed":15262,"user":{"displayName":"JIEUN LEE","userId":"02287882068179401694"}},"outputId":"47c838b3-fc65-446b-c40d-2443fa6b6476"},"execution_count":32,"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/seaborn/regression.py:598: UserWarning: sharex is deprecated from the `lmplot` function signature. Please update your code to pass it using `facet_kws`.\n","  warnings.warn(msg, UserWarning)\n","/usr/local/lib/python3.12/dist-packages/seaborn/regression.py:598: UserWarning: sharey is deprecated from the `lmplot` function signature. Please update your code to pass it using `facet_kws`.\n","  warnings.warn(msg, UserWarning)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 3600x3600 with 15 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import pandas as pd\n","\n","# ==============================================================================\n","#@ti