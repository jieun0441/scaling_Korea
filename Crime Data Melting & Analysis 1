x in df_viz_major['Crime_Type_Major'].unique() if any(\"\\u3131\" <= c <= \"\\u3163\" or \"\\uac00\" <= c <= \"\\ud7a3\" for c in x)]\n","\n","if remaining_korean:\n","    print(f\"아직 번역되지 않은 한글 범죄 유형이 있습니다: {remaining_korean}\")\n","else:\n","    print(\"모든 범죄 유형이 완벽하게 영문으로 변환되었습니다!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"A5D2F4KPkZ2F","executionInfo":{"status":"ok","timestamp":1772606306591,"user_tz":-540,"elapsed":17,"user":{"displayName":"JIEUN LEE","userId":"02287882068179401694"}},"outputId":"cff37676-4965-4b81-f6ee-3bcfe647fd0a"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["모든 범죄 유형이 완벽하게 영문으로 변환되었습니다!\n"]}]},{"cell_type":"code","source":["import numpy as np\n","import statsmodels.api as sm\n","import pandas as pd\n","\n","# ==============================================================================\n","#@title OLS Regression\n","# [Function] OLS Regression for Scaling Exponent (Beta)\n","# ==============================================================================\n","def calculate_scaling_metrics(df, year, crime_col='Crime_Count', pop_col='Pop_Reg'):\n","    subset = df[df['Year'] == year].copy()\n","\n","    # 0 이하 값 제거 (로그 변환 위해)\n","    subset = subset[(subset[crime_col] > 0) & (subset[pop_col] > 0)]\n","\n","    if len(subset) < 10:\n","        return None\n","\n","    y = np.log(subset[crime_col])\n","    x = np.log(subset[pop_col])\n","\n","    X = sm.add_constant(x)\n","    model = sm.OLS(y, X).fit()\n","\n","    return {\n","        'Year': year,\n","        'Beta': model.params[pop_col],\n","        'Std_Error': model.bse[pop_col],\n","        'R_Squared': model.rsquared,\n","        'P_Value': model.pvalues[pop_col],\n","        'N_Cities': int(model.nobs)\n","    }\n","\n","# ==============================================================================\n","# [Analysis 1] Total Crime Scaling (2015-2024)\n","# ===================================================================