", \"경상남도양산시\", \"경상남도창원시\",\n","    \"경상남도의령군\", \"경상남도함안군\", \"경상남도창녕군\", \"경상남도고성군\", \"경상남도남해군\", \"경상남도하동군\", \"경상남도산청군\",\n","    \"경상남도함양군\", \"경상남도거창군\", \"경상남도합천군\", \"제주특별자치도제주시\", \"제주특별자치도서귀포시\"\n","]\n","\n","# 빠른 검색을 위해 Set으로 변환\n","target_cities_set = set(target_cities)\n"],"metadata":{"id":"yZTejS5HJZnK"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ==============================================================================\n","# 2. [최종 수정] 지역명 매핑(Standardization) 함수 정의 - 공백 및 붙임말 완벽 대응\n","# ==============================================================================\n","\n","# 1. 매핑 사전(Dictionary) 자동 구축\n","# 162개 타겟 도시를 분석하여, 입력될 수 있는 다양한 변형들을 Key로, 타겟 도시명을 Value로 저장합니다.\n","\n","city_mapping_dict = {}\n","\n","# (A) 도(Province) 접두사 정의\n","province_prefixes = {\n","    \"경기도\": [\"경기\", \"경기도\"],\n","    \"강원특별자치도\": [\"강원\", \"강원도\", \"강원특별자치도\"],\n","    \"충청북도\": [\"충북\", \"충청북도\"],\n","    \"충청남도\": [\"충남\", \"충청남도\"],\n","    \"전북특별자치도\": [\"전북\", \"전라북도\", \"전북특별자치도\"],\n","    \"전라남도\": [\"전남\", \"전라남도\"],\n","    \"경상북도\": [\"경북\", \"경상북도\"],\n","    \"경상남도\": [\"경남\", \"경상남도\"],\n","    \"제주특별자치도\": [\"제주\", \"제주도\", \"제주특별자치도\"]\n","}\n","\n","for target in target_cities:\n","    # 1. 시/도 이름과 도시 이름 분리 (예: \"경기도수원시\" -> \"경기도\", \"수원시\")\n","    # 타겟 리스트는 표준화되어 있으므로 접두사를 기준으로 자릅니다.\n","\n","    matched_prov = \"\"\n","    short_name = target # 기본값\n","\n","    for prov_std, aliases in province_prefixes.items():\n","        if target.startswith(prov_std):\n","            matched_prov = prov_std\n","            short_name = target.replace(prov_std, \"\") # \"수원시\"\n","\n","            # (1) 핵심 이름 추출 (\"수원시\" -> \"수원\")\n","            core_name = short_name\n","            if short_name.endswith(\"시\") or short_name.endswith(\"군\"):\n","                core_name = short_name[:-1]\n","\n","            # (2) 다양한 조합 생성하여 사전에 등록\n","            # Case 1: \"수원\" -> \"경기도수원시\"\n","            city_mapping_dict[core_name] = target\n","            # Case 2: \"수원시\" -> \"경기도수원시\"\n","            city_mapping_dict[short_name] = target\n","\n","            # Case 3: 도 이름 별칭 + 도시 이름 조합\n","            # 예: \"경기수원\", \"경기수원시\", \"경기도수원\", \"경기도수원시\"\n","            for alias in aliases:\n","                city_mapping_dict[alias + core_name] = target\n","                city_mapping_dict[alias + short_name] = target\n","            break\n","\n","    # 매칭되는 도가 없는 경우 (광역시 등) -> 아래 로직에서 별도 처리하지만, 혹시 모르니 원본 등록\n","    if matched_prov == \"\":\n","        city_mapping_dict[target] = target\n","\n","# (B) 예외 처리 및 통합 창원시 추가\n","gyeongnam_changwon = \"경상남도창원시\"\n","manual_adds = [\"마산\", \"마산시\", \"창원시마산합포구\", \"창원시마산회원구\", \"진해\", \"진해시\", \"창원시진해구\",\n","               \"경남마산\", \"경남진해\", \"마산합포구\", \"마산회원구\", \"진해구\"]\n","for m in manual_adds:\n","    city_mapping_dict[m] = gyeongnam_changwon\n","\n","# ------------------------------------------------------------------\n","# 군위군 처리 (경북 군위군 -> 대구광역시로 통합)\n","# ------------------------------------------------------------------\n","# 선생님의 Target List에는 '군위군'이 별도로 없고 '대구광역시'만 존재하므로\n","# 과거 군위군 데이터를 대구광역시에 합산합니다.\n","city_mapping_dict[\"군위군\"] = \"대구광역시\"\n","city_mapping_dict[\"경북군위군\"] = \"대구광역시\"\n","city_mapping_dict[\"경상북도군위군\"] = \"대구광역시\"\n","# ------------------------------------------------------------------\n","\n","def standardize_city_name(raw_city):\n","    # 1. 전처리: 문자열 변환 및 모든 공백 제거 (핵심!)\n","    # \"서울 종로구\" -> \"서울종로구\", \"경기 수원시\" -> \"경기수원시\"\n","    name = str(raw_city).replace(\" \", \"\").strip()\n","\n","    # 2. 광역시/특별시 처리 (Startswith로 강력하게 잡기)\n","    # 뒤에 구가 붙든 안 붙든 무조건 통합\n","    if name.startswith(\"서울\"): return \"서울특별시\"\n","    if name.startswith(\"부산\"): return \"부산광역시\"\n","    if name.startswith(\"대구\"): return \"대구광역시\"\n","    if name.startswith(\"인천\"): return \"인천광역시\"\n","    if name.startswith(\"광주\"): return \"광주광역시\"\n","    if name.startswith(\"대전\"): return \"대전광역시\"\n","    if name.startswith(\"울산\"): return \"울산광역시\"\n","    if name.startswith(\"세종\"): return \"세종특별자치시\"\n","\n","    # 3. 사전 기반 매핑 (도 지역 시/군)\n","    if name in city_mapping_dict:\n","        return city_mapping_dict[name]\n","\n","    # 4. 사전 매칭 실패 시, '구' 단위 데이터인지 확인 (예: '분당구', '일산동구')\n","    # 대부분 3번에서 해결되지만, 혹시 모르니\n","    # (일단은 원본 반환 -> 기타/도시이외 등은 여기서 걸러짐)\n","\n","    return name\n","\n","\n","# ==============================================================================\n","# 3. 데이터 변환 및 집계\n","# ==============================================================================\n","\n","# (1) City 이름 표준화 적용\n","df_final['Standard_City'] = df_final['City'].apply(standardize_city_name)\n","\n","# (2) Target List에 있는 지역만 필터링 (매칭 안 된 지역 확인)\n","# 군위군 같은 경우 과거 경북이었으나 현재 대구로 편입됨.\n","# 사용자의 Target List에는 '대구광역시'만 있고 '군위군'은 없음 -> 대구로 통합됨.\n","# 다만 과거 데이터의 '경북 군위군'은 '경상북도군위군'으로 매핑될 텐데, 이는 Target List에 없음.\n","# 이를 위해 군위군 예외처리를 하거나, 일단 변환 후 Target List에 있는 것만 남깁니다.\n","\n","# 데이터 손실 방지를 위한 예외 처리 (군위군 이슈 등)\n","def post_correction(row):\n","    city = row['Standard_City']\n","    # 예: 경상북도군위군 -> 대구광역시 (최신 행정구역 기준 통일 시)\n","    # 하지만 연도별로 그대로 두고 싶다면 유지.\n","    # 사용자의 리스트에 '경상북도군위군'이 없으므로, 분석에서 제외되거나 대구로 합쳐야 함.\n","    # 여기서는 사용자 리스트에 포함된 것만 남기겠습니다.\n","    return city\n","\n","df_final['Standard_City'] = df_final.apply(post_correction, axis=1)\n","\n","# 유효한 데이터만 추출 (Target List에 있는 지역명)\n","valid_data = df_final[df_final['Standard_City'].isin(target_cities_set)].copy()\n","\n","# 제외된 데이터 확인 (디버깅용)\n","excluded_data = df_final[~df_final['Standard_City'].isin(target_cities_set)]\n","print(f\"매핑 후 Target List에 포함되어 분석 대상이 된 데이터 행 수: {len(valid_data)}\")\n","print(f\"제외된 데이터 행 수 (Target List에 없음): {len(excluded_data)}\")\n","if len(excluded_data) > 0:\n","    print(\"제외된 지역 예시:\", excluded_data['Standard_City'].unique()[:10])\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"TEcYPdoKFtph","executionInfo":{"status":"ok","timestamp":1772599375065,"user_tz":-540,"elapsed":642,"user":