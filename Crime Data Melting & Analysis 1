{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"toc_visible":true,"mount_file_id":"1pjSl3OWHdlTlOLYj7uexeBukuMF3XQNA","authorship_tag":"ABX9TyPNJAg1DfWKUuCUEmWzhWDc"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["import pandas as pd\n","import re\n","import os\n","\n","# --------------------------------------------------------------------------\n","# file path\n","file_path = '/content/drive/MyDrive/Urban Scaling/Crime Data/범죄발생지역통계_2012_2024.xlsx'\n","# --------------------------------------------------------------------------\n","\n","def process_crime_data(file_path):\n","    # 엑셀 파일 로드 (시트 이름만 먼저 확인)\n","    xls = pd.ExcelFile(file_path)\n","    sheet_names = xls.sheet_names\n","\n","    print(f\"총 {len(sheet_names)}개의 시트를 확인했습니다: {sheet_names}\")\n","\n","    all_data_frames = []\n","\n","    for sheet in sheet_names:\n","        # 1. 시트 이름에서 연도 추출 (정규표현식 사용)\n","        # 예: \"경찰청_범죄발생지_20151231\" -> 2015, \"경찰청_범죄발생지_2012\" -> 2012\n","        match = re.search(r'(\\d{4})', sheet)\n","        if match:\n","            year = match.group(1)\n","        else:\n","            print(f\"Warning: 시트명 [{sheet}]에서 연도를 찾을 수 없어 건너뜁니다.\")\n","            continue\n","\n","        # 2. 해당 시트 데이터 읽기\n","        try:\n","            df = pd.read_excel(file_path, sheet_name=sheet)\n","        except Exception as e:\n","            print(f\"Error: [{sheet}] 시트를 읽는 중 오류 발생 - {e}\")\n","            continue\n","\n","        # 3. 데이터 전처리: '범죄대분류', '범죄중분류'를 제외한 나머지는 모두 지역 컬럼으로 간주\n","        # 이 방식을 쓰면 시트마다 지역 개수가 달라도 상관없습니다.\n","        id_vars = ['범죄대분류', '범죄중분류']\n","\n","        # 만약 데이터에 불필요한 공백이 있을 수 있으니 컬럼명 공백 제거\n","        df.columns = [str(col).strip() for col in df.columns]\n","\n","        # id_vars가 실제 컬럼에 있는지 확인 (혹시 오타가 있을 경우를 대비)\n","        available_id_vars = [col for col in id_vars if col in df.columns]\n","\n","        if len(available_id_vars) != 2:\n","            print(f\"Warning: [{sheet}] 시트에 '범죄대분류' 또는 '범죄중분류' 컬럼이 없어 건너뜁니다.\")\n","            continue\n","\n","        # 4. Wide format -> Long format 변환 (Melt 수행)\n","        # 지역 컬럼들이 행으로 내려오게 됩니다.\n","        df_melted = pd.melt(\n","            df,\n","            id_vars=available_id_vars,\n","            var_name='City',     # 지역명이 들어갈 임시 컬럼명\n","            value_name='Crime_Count' # 범죄건수가 들어갈 임시 컬럼명\n","        )\n","\n","        # 5. 연도 컬럼 추가\n","        df_melted['Year'] = int(year)\n","\n","        # 6. 리스트에 추가\n","        all_data_frames.append(df_melted)\n","        print(f\"[{year}] 데이터 처리 완료 ({len(df_melted)}행)\")\n","\n","    # 7. 모든 연도 데이터 합치기\n","    if all_data_frames:\n","        final_df = pd.concat(all_data_frames, ignore_index=True)\n","\n","        # 8. 컬럼 이름 영문으로 변경 및 순서 재배치\n","        # 목표: 'Year', 'City', 'Crime_Type_Major', 'Crime_Type_Minor', 'Crime_Count'\n","\n","        # 먼저 컬럼명 매핑\n","        col_map = {\n","            '범죄대분류': 'Crime_Type_Major',\n","            '범죄중분류': 'Crime_Type_Minor',\n","            'City': 'City',\n","            'Crime_Count': 'Crime_Count',\n","            'Year': 'Year'\n","        }\n","        final_df.rename(columns=col_map, inplace=True)\n","\n","        # 컬럼 순서 정리\n","        final_df = final_df[['Year', 'City', 'Crime_Type_Major', 'Crime_Type_Minor', 'Crime_Count']]\n","\n","        # 9. 결측치 처리 (선택사항: 범죄건수가 비어있거나 '-'인 경우 0으로 처리 등)\n","        # 엑셀 데이터 특성상 숫자가 아닌 문자가 섞여 있을 수 있어 숫자로 변환\n","        final_df['Crime_Count'] = pd.to_numeric(final_df['Crime_Count'], errors='coerce').fillna(0).astype(int)\n","\n","        print(\"\\n\" + \"=\"*50)\n","        print(\"최종 통합 완료!\")\n","        print(f\"총 데이터 행 수: {len(final_df)}\")\n","        print(\"=\"*50)\n","\n","        return final_df\n","    else:\n","        print(\"처리된 데이터가 없습니다.\")\n","        return None\n","\n","# 실행\n","df_final = process_crime_data(file_path)\n","\n","# 결과 확인 (상위 5개)\n","if df_final is not None:\n","    dis